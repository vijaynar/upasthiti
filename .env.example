# ─────────────────────────────────────────────────────────────
# Abhyas — Environment Variables Template
#
# This repo uses TWO env files at the repo root, loaded automatically by
# each app's dev script via dotenv-cli. Copy this file to create them:
#
#   cp .env.example .env.development.local   (Local Supabase / Docker — everyday dev)
#   cp .env.example .env.production.local    (hosted Supabase — staging/prod only)
#
# Both are gitignored. NEVER commit real values. NEVER mix the two —
# development must only ever point at your local Docker Supabase instance.
# ─────────────────────────────────────────────────────────────

# ── Supabase ───────────────────────────────────────────────────
# Local:      http://127.0.0.1:54321  (from `npm run supabase:start`)
# Staging/Prod: https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — ONLY used server-side (API routes, scripts), never expose to client
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection (migrations & admin scripts)
# Local: postgresql://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_URL=

# ── App Config ────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Abhyas

# Google Maps JS API key (Places API enabled, restricted to this app's origin).
# Powers live Places Autocomplete in Coach Onboarding's Service Area/Community
# picker. Leave blank to keep manual-entry fallback mode — see docs/coach_service_areas.md
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ── Our session JWTs (Doc 05 §6) ──────────────────────────────
# RS256 keypair we sign sessions with — Supabase's own tokens are discarded
# inside the auth adapter. Generate with `npm run keys:generate`.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# ── Worker (apps/worker, Doc 14 §8) ───────────────────────────
WORKER_NAME=

# ── Notifications (Phase 10, Doc 07 §10) ──────────────────────
# Email: SMTP, defaults to local Supabase's Inbucket (127.0.0.1:54325, no
# auth) if unset — same infra Phase 2's magic-link emails already use. Set
# these for a real relay in staging/prod.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Push: Web Push (VAPID) — no vendor account needed. Generate with
# `npm run keys:generate:vapid`.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# Exposed to the browser (apps/web) so it can call PushManager.subscribe().
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Google Maps JS API key (Places API enabled, restricted to this app's origin).
# Powers live Places Autocomplete in Coach Onboarding's Service Area/Community
# picker. Leave blank to keep manual-entry fallback mode — see docs/coach_service_areas.md
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ── Mobile app (apps/mobile) ───────────────────────────────────
# Deprioritized (2026-07-19 decision) — v1 ships web-only, mobile-compatible
# responsive UI instead of a native Expo app. Left commented for whenever
# apps/mobile is picked back up; do not fill these in for the web build.
# EXPO_PUBLIC_SUPABASE_URL=
# EXPO_PUBLIC_SUPABASE_ANON_KEY=
# EXPO_PUBLIC_API_BASE_URL=http://localhost:3000/api/v1

# ── Deferred auth methods (Doc 05 §2) ─────────────────────────
# Phone OTP is deferred in v1 (Google OAuth + email magic link only,
# 2026-07-19 decision) — kept here so enabling it later is a config change.
# SMS_PROVIDER_API_KEY=
# SMS_DLT_ENTITY_ID=

# ── Deferred notification channels (Doc 08/14, 2026-07-19 decision) ───
# WhatsApp/SMS channel adapters ship stubbed (`not_configured`) until a BSP
# vendor is chosen — fill these in to flip a channel live, no code change.
# WHATSAPP_BSP_API_KEY=
# WHATSAPP_PHONE_NUMBER_ID=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=

# ── Deferred — other future modules ───────────────────────────
# GEMINI_API_KEY=
# RESEND_API_KEY=
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
