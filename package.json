{
  "name": "abhyas",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/modules/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@abhyas/web",
    "dev:worker": "turbo run dev --filter=worker",
    "lint": "eslint .",
    "lint:legacy": "turbo run lint",
    "type-check": "turbo run type-check",
    "clean": "turbo run clean && rimraf node_modules",
    "test": "echo \"[test] no test runner configured yet (roadmap Phase 16)\" && exit 0",
    "test:isolation": "echo \"[test:isolation] RLS isolation suite lands with Phase 3-4 (org core + RBAC)\" && exit 0",
    "keys:generate": "node scripts/generate-keys.mjs",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local > packages/db-types/src/index.ts",
    "db:studio": "start http://127.0.0.1:54323",
    "db:lint": "supabase db lint",
    "db:check-rls": "node scripts/check-rls-coverage.mjs",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status",
    "supabase:reset": "supabase db reset",
    "supabase:types": "supabase gen types typescript --local > packages/database/src/types.ts",
    "supabase:studio": "start http://127.0.0.1:54323",
    "supabase:lint": "supabase db lint"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@typescript-eslint/eslint-plugin": "^8.19.0",
    "@typescript-eslint/parser": "^8.19.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "pg": "^8.21.0"
  }
}
